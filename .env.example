# ==============================================================================
# Master AI Portfolio - Environment Variables Template
# Copy this file to .env and replace the placeholder values.
# NEVER commit your real .env file with secrets to Git.
# ==============================================================================

# --- Azure OpenAI Service Configuration ---
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-api-key-here
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini

# --- Optional Hugging Face Hub Token ---
HUGGINGFACE_TOKEN=your-huggingface-token-here

# --- General Configuration ---
ENVIRONMENT=development
LOG_LEVEL=INFO
